// Merge these matches into the bucket's existing version-2 rules before deploying.
// Do not replace rules used by other app features with this file without reviewing them.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function backupID(id) {
      return id.matches('[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}');
    }

    match /turnscene-backups/{uid}/{path=**} {
      allow get, list, delete: if owner(uid);
    }
    match /turnscene-backups/{uid}/{backup}/manifest.json {
      allow create: if owner(uid) && backupID(backup)
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }
    match /turnscene-backups/{uid}/{backup}/Photos/{photo} {
      allow create: if owner(uid) && backupID(backup)
        && photo.matches('[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\.jpg')
        && request.resource.size > 0
        && request.resource.size <= 64 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
  }
}
